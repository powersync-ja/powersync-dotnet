<Page x:Class="UnoTodo.Presentation.TodoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:UnoTodo.Presentation"
      xmlns:models="using:UnoTodo.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:conv="using:UnoTodo.Presentation.Converters"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

  <Page.Resources>
    <conv:PathToImageSourceConverter x:Key="PathToImageSource" />
  </Page.Resources>

  <Grid x:Name="Root" Tag="{Binding List}" utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <utu:NavigationBar Content="{Binding Title}" />

    <Button Grid.Row="1"
            Content="New Todo"
            Click="OnAddClicked"
            Margin="16,8"
            HorizontalAlignment="Right" />

    <ListView Grid.Row="2"
              x:Name="TodoItemsCollection"
              ItemsSource="{Binding Todos}"
              SelectionMode="Single"
              SelectionChanged="OnItemSelectionChanged">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="models:TodoItem">
          <Border BorderBrush="Gray"
                  BorderThickness="1"
                  CornerRadius="5"
                  Padding="12"
                  Margin="12,6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{x:Bind Description}"
                         FontSize="16"
                         VerticalAlignment="Center" />
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="10"
                          VerticalAlignment="Center">
                <Button Content="No photo"
                        Visibility="{x:Bind HasNoPhoto}"
                        Click="OnPhotoClicked" />
                <ProgressRing IsActive="{x:Bind IsDownloading}"
                              Visibility="{x:Bind IsDownloading}"
                              Width="32"
                              Height="32" />
                <Button Padding="0"
                        Visibility="{x:Bind IsPhotoReady}"
                        Click="OnPhotoClicked">
                  <Image Source="{x:Bind PhotoLocalUri, Converter={StaticResource PathToImageSource}}"
                         Width="48"
                         Height="48"
                         Stretch="UniformToFill" />
                </Button>
                <CheckBox IsChecked="{x:Bind Completed}"
                          Checked="OnCheckBoxChanged"
                          Unchecked="OnCheckBoxChanged"
                          VerticalAlignment="Center" />
                <Button Content="Delete" Click="OnDeleteClicked" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
